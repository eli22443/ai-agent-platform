APP_ENV=local
LOG_LEVEL=INFO
DEBUG=false
DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@127.0.0.1:5432/ai_agent_platform
WORKSPACES_ROOT=.workspaces
GIT_CLONE_TIMEOUT_SECONDS=120
MAX_REPO_SIZE_MB=200
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
RIPGREP_PATH=rg
TOOL_READ_MAX_BYTES=65536
TOOL_READ_MAX_LINES=500
TOOL_SEARCH_MAX_RESULTS=50
TOOL_SEARCH_TIMEOUT_SECONDS=30
TOOL_GIT_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_TOKEN_BUDGET=0

# Phase 8 — semantic retrieval (see docs/phases/phase-08.md)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX=
RETRIEVAL_CHUNK_LINES=80
RETRIEVAL_CHUNK_OVERLAP=20
RETRIEVAL_MAX_FILE_BYTES=256000
RETRIEVAL_EMBED_BATCH_SIZE=64
RETRIEVAL_SEARCH_TOP_K=10
RETRIEVAL_INDEX_ENABLED=true

# Phase 9 — background execution (see docs/phases/phase-09.md)
REDIS_URL=redis://127.0.0.1:6379/0

# Deploy track: cloud uses Supabase DATABASE_URL (see docs/deploy-track.md)
# Local dev keeps apt Postgres (D19); append ?sslmode=require for Supabase direct connection