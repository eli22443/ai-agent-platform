APP_ENV=local
LOG_LEVEL=INFO
DEBUG=false
DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@127.0.0.1:5432/ai_agent_platform
WORKSPACES_ROOT=.workspaces
GIT_CLONE_TIMEOUT_SECONDS=120
MAX_REPO_SIZE_MB=200
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
RIPGREP_PATH=rg
TOOL_READ_MAX_BYTES=65536
TOOL_READ_MAX_LINES=500
TOOL_SEARCH_MAX_RESULTS=50
TOOL_SEARCH_TIMEOUT_SECONDS=30
TOOL_GIT_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_MAX_ITERATIONS=20
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_TOKEN_BUDGET=0