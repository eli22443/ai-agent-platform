# Settings for the on-demand EC2 demo host (compose + Cloudflare Tunnel).
# Sourced by infrastructure/ec2/lib.sh.

AWS_REGION=eu-north-1

# --- Instance ---------------------------------------------------------------
INSTANCE_NAME=ai-agent-demo
# arm64 (Graviton). Cheaper later downsize: t4g.micro.
INSTANCE_TYPE=t4g.small
ROOT_VOLUME_GB=20
AMI_SSM_PARAMETER=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64

# --- Network (D27: no default VPC) ------------------------------------------
VPC_NAME=ai-agent-vpc
SUBNET_NAME=ai-agent-public-1
SECURITY_GROUP_NAME=ai-agent-demo-sg

# --- IAM --------------------------------------------------------------------
ROLE_NAME=ai-agent-demo-ec2-role
INSTANCE_PROFILE_NAME=ai-agent-demo-ec2-role
SECRETS_ARN_PATTERN=arn:aws:secretsmanager:eu-north-1:099357569747:secret:ai-agent-platform/*

# --- Secrets ----------------------------------------------------------------
# JSON object with the backend/.env keys plus CLOUDFLARE_TUNNEL_TOKEN.
# Optional GITHUB_TOKEN (read-only) is used only if the repo is private.
SECRET_ID=ai-agent-platform/app

# --- Public URL (Cloudflare Tunnel on zone airepo.app) ----------------------
DEMO_HOSTNAME=api.airepo.app
HEALTH_URL=https://api.airepo.app/health

# --- App on the instance ----------------------------------------------------
REPO_URL=https://github.com/eli22443/ai-agent-platform
REPO_BRANCH=master
APP_DIR=/opt/ai-agent-platform

# --- Waiting ----------------------------------------------------------------
# First boot builds the image on the instance, so give provision a long budget.
WAIT_TIMEOUT_SECONDS=1200
POLL_INTERVAL_SECONDS=10
