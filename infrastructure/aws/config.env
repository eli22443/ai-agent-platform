# Resource names for local start/stop schedule (ECS + Redis).
# Redis is an ElastiCache *replication group* (not a standalone cache cluster).

AWS_REGION=eu-north-1

ECS_CLUSTER=ai-agent-cluster
ECS_API_SERVICE=ai-agent-api-service-2sdqusn9
ECS_WORKER_SERVICE=ai-agent-worker-service
DESIRED_COUNT_ON=1

REDIS_REPLICATION_GROUP_ID=ai-agent-redis
CACHE_NODE_TYPE=cache.t4g.micro
REDIS_ENGINE=redis
REDIS_ENGINE_VERSION=7.1
REDIS_PORT=6379
REDIS_SNAPSHOT_RETENTION=1
REDIS_NUM_CACHE_CLUSTERS=1
REDIS_SUBNET_GROUP_NAME=ai-agent-redis
REDIS_SECURITY_GROUP_ID=sg-039e24bab89dfef74
REDIS_SECURITY_GROUP_NAME=ai-agent-redis-sg

SECRET_ID=ai-agent-platform/app

HEALTH_URL=https://api.airepoagent.app/health
# Seconds to wait for Redis create/delete and ECS drain
WAIT_TIMEOUT_SECONDS=1200
POLL_INTERVAL_SECONDS=15
